  //   {
  //     "binding": "DB",
  //     "database_name": "ringkasnya-db",
  //     "database_id": "<D1_DATABASE_ID>"
  //   }
  // ],
  // "kv_namespaces": [
  //   {
  //     "binding": "SESSION_KV",
  //     "id": "<KV_NAMESPACE_ID>"
  //   }
  // ]
}
