{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ringkasnya-db",
      "database_id": "97f9180f-c75c-434b-aefb-94bdba512726",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ringkasnya-db-preview",
        "database_id": "1bd684d1-0202-47a5-bb8e-3b46855888e5",
        "migrations_dir": "migrations"
      }
    ]
  }
  // Siap diaktifkan untuk Fase 3 (Session & Rate Limiting):
  // "kv_namespaces": [
  //   {
  //     "binding": "SESSION_KV",
  //     "id": "<KV_NAMESPACE_ID>"
  //   }
  // ]
}
