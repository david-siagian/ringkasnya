{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
  // Siap diaktifkan untuk Fase 3 (Login Auth & Payment Gateway):
