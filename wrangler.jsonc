{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://dev-app.ringkasnya.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ringkasnya-db",
      "database_id": "97f9180f-c75c-434b-aefb-94bdba512726",
      "preview_database_id": "1bd684d1-0202-47a5-bb8e-3b46855888e5",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_KV",
      "id": "8b4bdc32e4494dbbbffff764b3e99140",
      "preview_id": "c21a2251722d4a7ea5b5d3c6a315db2f"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ringkasnya-db-preview",
        "database_id": "1bd684d1-0202-47a5-bb8e-3b46855888e5",
        "migrations_dir": "migrations"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "SESSION_KV",
        "id": "c21a2251722d4a7ea5b5d3c6a315db2f"
      }
    ]
  }
}
