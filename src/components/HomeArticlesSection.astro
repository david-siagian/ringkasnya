---
import { formatArticlePublishedDate, type Article } from "@/types/article";
import { ArrowRight, Calendar } from "lucide-react";

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

const displayedArticles = articles.slice(0, 4);
---

{
  displayedArticles.length > 0 && (
    <section
      id="artikel"
      class="scroll-mt-20 border-t border-line/80 bg-page/50 py-12 sm:py-14"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
              Artikel Pendamping
            </span>
            <h2 class="mt-1 text-xl font-extrabold tracking-tight text-ink sm:text-2xl">
              Menu Tambahan untuk Memperkaya Konteks Bacaan
            </h2>
          </div>

          <a
            href="/artikel"
            class="group inline-flex shrink-0 items-center gap-1.5 self-end text-xs font-semibold text-accent-strong transition-colors hover:text-accent-text sm:self-auto sm:text-sm"
          >
            <span>Lihat Semua Artikel</span>
            <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:gap-5">
          {displayedArticles.map((article) => (
            <a
              href={`/artikel/${article.slug}`}
              class="group flex items-center gap-3.5 rounded-2xl border border-line/90 bg-surface p-3.5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-line hover:shadow-md sm:gap-4 sm:p-5 lg:gap-5 lg:p-6"
            >
              {article.coverImage && (
                <div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl ring-1 ring-line/60 sm:h-20 sm:w-20 md:h-24 md:w-24 lg:h-28 lg:w-28">
                  <img
                    src={article.coverImage}
                    alt={`Ilustrasi artikel ${article.title}`}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              )}

              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 text-[11px] sm:text-xs">
                  <span class="font-semibold text-accent-text">
                    {article.accentBadge}
                  </span>
                  <span class="text-ink-faint">&middot;</span>
                  <span class="inline-flex items-center gap-1 text-ink-subtle">
                    <Calendar className="h-3 w-3 text-ink-faint sm:h-3.5 sm:w-3.5" />
                    {formatArticlePublishedDate(article.publishedAt)}
                  </span>
                </div>
                <h3 class="mt-1 line-clamp-2 text-sm font-extrabold leading-snug text-ink transition-colors group-hover:text-accent-text sm:text-base lg:text-lg">
                  {article.title}
                </h3>
                <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-ink-muted sm:text-sm">
                  {article.subtitle}
                </p>
              </div>

              <ArrowRight className="hidden h-4 w-4 shrink-0 text-ink-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent-strong sm:block lg:h-5 lg:w-5" />
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
