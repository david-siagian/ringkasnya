---
import { formatArticlePublishedDate, type Article } from "@/types/article";
import { ArrowRight, Calendar } from "lucide-react";

interface Props {
  articles: Article[];
  variant?: "compact-list" | "mini-strip";
  previewLabel?: string;
  sectionId?: string;
}

const {
  articles,
  variant = "compact-list",
  previewLabel,
  sectionId = "artikel",
} = Astro.props;

const displayedArticles = articles.slice(0, 4);
const isStrip = variant === "mini-strip";
---

{
  displayedArticles.length > 0 && (
    <section
      id={sectionId}
      class={`scroll-mt-20 border-t border-line/80 py-12 sm:py-14 ${
        isStrip ? "bg-surface" : "bg-page/50"
      }`}
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
                Artikel Pendamping
              </span>
              {previewLabel && (
                <span class="rounded-full border border-line bg-surface-subtle px-2.5 py-0.5 text-[10px] font-semibold text-ink-subtle">
                  {previewLabel}
                </span>
              )}
            </div>
            <h2 class="mt-1 text-xl font-extrabold tracking-tight text-ink sm:text-2xl">
              Bacaan Singkat, Gagasan Tajam
            </h2>
            <p class="mt-1 text-sm text-ink-muted">
              Bedah istilah ilmiah dan eksperimen klasik dalam 4–6 menit.
            </p>
          </div>

          <a
            href="/artikel"
            class="inline-flex items-center gap-1.5 self-start rounded-xl border border-line bg-surface px-4 py-2 text-xs font-semibold text-ink-secondary transition hover:border-accent-strong hover:text-accent-strong sm:self-auto sm:text-sm"
          >
            <span>Lihat semua artikel</span>
            <ArrowRight className="h-3.5 w-3.5" />
          </a>
        </div>

        {isStrip ? (
          <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            {displayedArticles.map((article) => (
              <a
                href={`/artikel/${article.slug}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-line/90 bg-page/60 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-line hover:bg-surface hover:shadow-md"
              >
                {article.coverImage && (
                  <div class="p-2.5 pb-0">
                    <div class="relative aspect-square w-full overflow-hidden rounded-xl ring-1 ring-line/60">
                      <img
                        src={article.coverImage}
                        alt={`Ilustrasi artikel ${article.title}`}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      />
                    </div>
                  </div>
                )}

                <div class="flex flex-1 flex-col justify-between p-3">
                  <div>
                    <span class="inline-block rounded-full bg-surface-subtle px-2 py-0.5 text-[10px] font-medium text-ink-muted">
                      {article.accentBadge}
                    </span>
                    <h3 class="mt-2 line-clamp-2 text-xs font-extrabold leading-snug text-ink group-hover:text-accent-text sm:text-sm">
                      {article.title}
                    </h3>
                  </div>

                  <div class="mt-2.5 flex items-center justify-between text-[11px] text-ink-subtle">
                    <span class="inline-flex items-center gap-1">
                      <Calendar className="h-3 w-3 text-ink-faint" />
                      {formatArticlePublishedDate(article.publishedAt)}
                    </span>
                    <ArrowRight className="h-3.5 w-3.5 text-ink-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent-strong" />
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="mt-6 grid grid-cols-1 gap-3.5 md:grid-cols-2">
            {displayedArticles.map((article) => (
              <a
                href={`/artikel/${article.slug}`}
                class="group flex items-center gap-3.5 rounded-2xl border border-line/90 bg-surface p-3.5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-line hover:shadow-md"
              >
                {article.coverImage && (
                  <div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl ring-1 ring-line/60 sm:h-20 sm:w-20">
                    <img
                      src={article.coverImage}
                      alt={`Ilustrasi artikel ${article.title}`}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  </div>
                )}

                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 text-[11px]">
                    <span class="font-semibold text-accent-text">
                      {article.accentBadge}
                    </span>
                    <span class="text-ink-faint">&middot;</span>
                    <span class="inline-flex items-center gap-1 text-ink-subtle">
                      <Calendar className="h-3 w-3 text-ink-faint" />
                      {formatArticlePublishedDate(article.publishedAt)}
                    </span>
                  </div>
                  <h3 class="mt-0.5 line-clamp-1 text-sm font-extrabold text-ink group-hover:text-accent-text sm:text-base">
                    {article.title}
                  </h3>
                  <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-ink-muted">
                    {article.subtitle}
                  </p>
                </div>

                <ArrowRight className="hidden h-4 w-4 shrink-0 text-ink-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent-strong sm:block" />
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
