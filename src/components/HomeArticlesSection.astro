---
import { formatArticlePublishedDate, type Article } from "@/types/article";
import { ArrowRight, Calendar } from "lucide-react";

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

const displayedArticles = articles.slice(0, 4);
---

{
  displayedArticles.length > 0 && (
    <section
      id="artikel"
      class="scroll-mt-20 border-t border-line/80 bg-page/50 py-16 sm:py-20"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
              Artikel Pendamping
            </span>
            <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
              Menu Tambahan untuk Memperkaya Konteks Bacaan
            </h2>
          </div>

          <a
            href="/artikel"
            class="group inline-flex shrink-0 items-center gap-1.5 self-end text-xs font-semibold text-accent-strong transition-colors hover:text-accent-text sm:self-auto sm:text-sm"
          >
            <span>Lihat Semua Artikel</span>
            <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>

        <div class="mt-8 grid auto-rows-fr grid-cols-1 gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-5 lg:gap-6">
          {displayedArticles.map((article) => (
            <a
              href={`/artikel/${article.slug}`}
              class="group flex h-full min-h-[120px] items-stretch overflow-hidden rounded-2xl border border-line/80 bg-surface shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-line hover:shadow-md sm:min-h-[144px]"
            >
              {article.coverImage && (
                <div class="w-24 shrink-0 overflow-hidden border-r border-line/60 bg-slate-950 sm:w-28 md:w-32">
                  <img
                    src={article.coverImage}
                    alt={`Ilustrasi artikel ${article.title}`}
                    class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              )}

              <div class="flex min-w-0 flex-1 flex-col justify-between px-3.5 py-2.5 sm:px-4 sm:py-3">
                <div>
                  <div class="flex items-center gap-2 text-[10px] sm:text-[11px]">
                    <span class="truncate font-semibold text-accent-text">
                      {article.accentBadge}
                    </span>
                    <span aria-hidden="true" class="text-ink-faint">&middot;</span>
                    <span class="inline-flex shrink-0 items-center gap-1 text-ink-subtle">
                      <Calendar className="h-3 w-3 text-ink-faint" />
                      {formatArticlePublishedDate(article.publishedAt)}
                    </span>
                  </div>

                  <h3 class="mt-1 min-h-[2.5em] line-clamp-2 text-[13px] font-bold leading-tight text-ink transition-colors group-hover:text-accent-text sm:text-sm">
                    {article.title}
                  </h3>
                  <p class="mt-1 min-h-[1.375em] line-clamp-1 text-[11px] leading-snug text-ink-muted sm:min-h-[2.75em] sm:line-clamp-2 sm:text-xs">
                    {article.subtitle}
                  </p>
                </div>

                <div class="mt-2 flex items-center justify-between border-t border-line-subtle pt-1.5 text-[11px] font-semibold text-accent-strong group-hover:text-accent-text">
                  <span>Baca Artikel</span>
                  <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5 sm:h-3.5 sm:w-3.5" />
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
