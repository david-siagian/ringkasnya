---
import { formatArticlePublishedDate, type Article } from "@/types/article";
import { ArrowRight, BookOpen, Calendar } from "lucide-react";

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

const MAX_OTHER_ARTICLES = 6;
const featuredArticle = articles[0];
const otherArticles = articles.slice(1, 1 + MAX_OTHER_ARTICLES);
---

{
  featuredArticle && (
    <section
      id="artikel"
      class="scroll-mt-20 border-t border-line/80"
    >
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
              Artikel &amp; Gagasan Ilmiah
            </span>
            <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
              Bacaan Singkat, Gagasan Tajam
            </h2>
            <p class="mt-1.5 text-sm text-ink-muted">
              Bedah istilah ilmiah, eksperimen klasik, dan konsep penting dalam bacaan ringan 4–6 menit.
            </p>
          </div>
        </div>

        <div class="mt-8 space-y-6">
          {/* 1 Artikel Pilihan */}
          <a
            href={`/artikel/${featuredArticle.slug}`}
            class="group flex flex-col items-stretch overflow-hidden rounded-2xl border border-accent-line/90 bg-gradient-to-br from-accent-soft/90 via-surface to-warm-soft/50 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-line hover:shadow-lg md:flex-row"
          >
            {featuredArticle.coverImage && (
              <div
                class={`flex w-full shrink-0 items-center justify-center bg-slate-900 bg-gradient-to-br ${featuredArticle.coverGradient} p-6 sm:p-8 md:w-72 lg:w-80`}
              >
                <div class="relative aspect-square w-40 overflow-hidden rounded-xl bg-black/20 shadow-[0_18px_36px_-8px_rgba(0,0,0,0.45)] ring-1 ring-white/25 sm:w-48 md:w-52">
                  <img
                    src={featuredArticle.coverImage}
                    alt={`Ilustrasi artikel ${featuredArticle.title}`}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              </div>
            )}

            <div class="flex min-w-0 flex-1 flex-col justify-between p-5 sm:p-7">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="rounded-full border border-accent-line bg-accent-soft px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-accent-text">
                    Artikel Pilihan
                  </span>
                  <span class="rounded-full bg-surface-subtle px-2.5 py-0.5 text-xs font-medium text-ink-muted">
                    {featuredArticle.accentBadge}
                  </span>
                </div>

                <p class="mt-3 text-xs font-semibold uppercase tracking-widest text-ink-subtle">
                  {featuredArticle.originLabel}
                </p>
                <h3 class="mt-1 text-2xl font-extrabold leading-snug tracking-tight text-ink group-hover:text-accent-text sm:text-3xl">
                  {featuredArticle.title}
                </h3>

                <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-muted">
                  <span class="inline-flex items-center gap-1 font-medium text-ink-secondary">
                    <Calendar className="h-3.5 w-3.5 text-accent-strong" />
                    {formatArticlePublishedDate(featuredArticle.publishedAt)}
                  </span>
                  <span class="inline-flex items-center gap-1">
                    <BookOpen className="h-3.5 w-3.5 text-ink-faint" />
                    {featuredArticle.category}
                  </span>
                </div>

                <p class="mt-4 text-sm leading-relaxed text-ink-muted sm:text-base">
                  {featuredArticle.subtitle}
                </p>
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-line-subtle pt-4 text-xs font-semibold text-accent-text group-hover:text-accent-strong sm:text-sm">
                <span>Baca Artikel Lengkap</span>
                <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </div>
            </div>
          </a>

          {/* Artikel Lainnya (Grid Vertikal) */}
          {otherArticles.length > 0 && (
            <div>
              <p class="mb-3 text-xs font-bold uppercase tracking-wider text-ink-subtle">
                Jelajahi Artikel Lainnya
              </p>
              <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3">
                {otherArticles.map((article) => (
                  <a
                    href={`/artikel/${article.slug}`}
                    class="group flex flex-col overflow-hidden rounded-2xl border border-line/90 bg-surface shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-accent-line hover:shadow-lg"
                  >
                    {article.coverImage && (
                      <div class="p-2.5 pb-0 sm:p-3 sm:pb-0">
                        <div class="relative aspect-square w-full overflow-hidden rounded-xl shadow-sm ring-1 ring-line/70">
                          <img
                            src={article.coverImage}
                            alt={`Ilustrasi artikel ${article.title}`}
                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                          />
                        </div>
                      </div>
                    )}

                    <div class="flex flex-1 flex-col justify-between p-3 sm:p-4">
                      <div>
                        <span class="inline-block max-w-full truncate rounded-full bg-surface-subtle px-2 py-0.5 text-[10px] font-medium text-ink-muted sm:px-2.5 sm:text-[11px]">
                          {article.category}
                        </span>

                        <p class="mt-2.5 truncate text-[10px] font-semibold uppercase tracking-widest text-ink-subtle sm:text-[11px]">
                          {article.accentBadge}
                        </p>
                        <h3 class="mt-0.5 line-clamp-2 text-sm font-extrabold leading-snug tracking-tight text-ink group-hover:text-accent-text sm:text-base">
                          {article.title}
                        </h3>
                        <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-ink-muted">
                          {article.subtitle}
                        </p>
                      </div>

                      <div class="mt-3 flex items-center justify-between border-t border-line-subtle pt-2.5 text-[11px] text-ink-subtle sm:text-xs">
                        <span class="inline-flex items-center gap-1">
                          <Calendar className="h-3 w-3 text-ink-faint sm:h-3.5 sm:w-3.5" />
                          {formatArticlePublishedDate(article.publishedAt)}
                        </span>
                        <ArrowRight className="h-3.5 w-3.5 text-ink-faint transition-transform group-hover:translate-x-0.5 group-hover:text-accent-strong" />
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Tombol Lihat Semua Artikel */}
        <div class="mt-10 flex justify-center">
          <a
            href="/artikel"
            class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-md shadow-emerald-600/20 transition-all duration-200 hover:bg-emerald-700 active:scale-[0.98]"
          >
            <span>Lihat Semua Artikel</span>
            <ArrowRight className="h-4 w-4" />
          </a>
        </div>
      </div>
    </section>
  )
}
