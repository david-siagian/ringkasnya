---
import { formatArticlePublishedDate, type Article } from "@/types/article";
import { ArrowRight, Calendar } from "lucide-react";

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;

const displayedArticles = articles.slice(0, 3);
---

{
  displayedArticles.length > 0 && (
    <section
      id="artikel"
      class="scroll-mt-20 border-t border-line/80 bg-page/50 py-16 sm:py-20"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
              Artikel Pendamping
            </span>
            <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
              Menu Tambahan untuk Memperkaya Konteks Bacaan
            </h2>
          </div>

          <a
            href="/artikel"
            class="group inline-flex shrink-0 items-center gap-1.5 self-end text-xs font-semibold text-accent-strong transition-colors hover:text-accent-text sm:self-auto sm:text-sm"
          >
            <span>Lihat Semua Artikel</span>
            <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
          </a>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-3.5 sm:mt-10 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
          {displayedArticles.map((article) => (
            <a
              href={`/artikel/${article.slug}`}
              class="group flex items-center gap-3.5 rounded-2xl border border-line/90 bg-surface p-3.5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-line hover:shadow-md sm:items-stretch sm:gap-0 sm:overflow-hidden sm:border-line/80 sm:p-0"
            >
              {article.coverImage && (
                <div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl ring-1 ring-line/60 sm:h-auto sm:w-36 sm:rounded-none sm:border-r sm:border-line/60 sm:bg-slate-950 sm:ring-0 md:w-40">
                  <img
                    src={article.coverImage}
                    alt={`Ilustrasi artikel ${article.title}`}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 sm:object-contain"
                  />
                </div>
              )}

              <div class="flex min-w-0 flex-1 flex-col justify-between sm:p-4">
                <div>
                  <div class="flex items-center gap-2 text-[11px]">
                    <span class="truncate font-semibold text-accent-text">
                      {article.accentBadge}
                    </span>
                    <span aria-hidden="true" class="text-ink-faint">&middot;</span>
                    <span class="inline-flex shrink-0 items-center gap-1 text-ink-subtle">
                      <Calendar className="h-3 w-3 text-ink-faint" />
                      {formatArticlePublishedDate(article.publishedAt)}
                    </span>
                  </div>

                  <h3 class="mt-0.5 line-clamp-1 text-sm font-extrabold text-ink transition-colors group-hover:text-accent-text sm:mt-1.5 sm:line-clamp-2 sm:text-sm sm:font-bold sm:leading-snug lg:text-[15px]">
                    {article.title}
                  </h3>
                  <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-ink-muted">
                    {article.subtitle}
                  </p>
                </div>

                <div class="mt-3 hidden items-center justify-between border-t border-line-subtle pt-2.5 text-[11px] font-semibold text-accent-strong group-hover:text-accent-text sm:flex">
                  <span>Baca Artikel</span>
                  <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
