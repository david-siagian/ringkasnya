---
import BrandLogo from "@/components/BrandLogo";

interface Props {
  title: string;
  headingId: string;
  closeHref?: string;
}

const { title, headingId, closeHref = "/" } = Astro.props;
---

<div
  class="fixed inset-0 z-[60] overflow-y-auto bg-slate-900/45 backdrop-blur-md dark:bg-black/65"
  role="dialog"
  aria-modal="true"
  aria-labelledby={headingId}
>
  <div class="flex min-h-full items-center justify-center p-4 sm:p-6">
    <div class="animate-fade-slide relative w-full max-w-md rounded-3xl border border-line bg-surface p-6 shadow-2xl ring-1 ring-black/5 dark:ring-white/10 sm:p-8">
      <a
        href={closeHref}
        aria-label="Kembali ke beranda"
        class="absolute right-4 top-4 inline-flex h-8 w-8 items-center justify-center rounded-full border border-line bg-page/80 text-ink-muted transition-colors hover:bg-page hover:text-ink focus:outline-none focus:ring-2 focus:ring-emerald-500/20"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </a>

      <div class="mb-6 text-center">
        <a href="/" class="inline-flex flex-col items-center gap-2">
          <BrandLogo className="h-12 w-12" />
        </a>
        <h1
          id={headingId}
          class="mt-3 text-2xl font-extrabold tracking-tight text-ink"
        >
          {title}
        </h1>
        <p class="mt-1.5 text-sm text-ink-muted">
          <slot name="subtitle" />
        </p>
      </div>

      <slot />
    </div>
  </div>
</div>
