---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { and, eq, gt } from "drizzle-orm";
import {
  getBookCatalog,
  PUBLIC_PAGE_CACHE_CONTROL,
} from "@/lib/books-repository";
import { getDb, schema } from "@/lib/db";
import { getDailySeed, shuffleWithSeed } from "@/lib/shuffle";
import { ARTICLES } from "@/data/articles";
import CatalogSection from "@/components/CatalogSection";
import HomeArticlesSection from "@/components/HomeArticlesSection.astro";
import {
  ArrowRight,
  Layers,
  Share2,
  Sparkles,
  Zap,
} from "lucide-react";

export const prerender = false;

const MIN_ENGAGED_BOOKS_FOR_HOME_SHUFFLE = 5;

const dbBinding = Astro.locals.runtime?.env?.DB;
const currentUser = Astro.locals.user;
const bookCatalog = await getBookCatalog(dbBinding);

let homeBooks = bookCatalog;
let homeArticles = ARTICLES;
let cacheControl = PUBLIC_PAGE_CACHE_CONTROL;

if (currentUser) {
  cacheControl = "private, no-store";

  if (dbBinding) {
    try {
      const db = getDb(dbBinding);
      const engagedRows = await db
        .select({
          bookSlug: schema.userBookProgress.bookSlug,
          progressPercent: schema.userBookProgress.progressPercent,
        })
        .from(schema.userBookProgress)
        .where(
          and(
            eq(schema.userBookProgress.userId, currentUser.id),
            gt(schema.userBookProgress.progressPercent, 0)
          )
        );

      if (engagedRows.length >= MIN_ENGAGED_BOOKS_FOR_HOME_SHUFFLE) {
        const userDailySeed = `${getDailySeed()}:${currentUser.id}`;
        const completedSlugs = new Set(
          engagedRows
            .filter((row) => row.progressPercent >= 100)
            .map((row) => row.bookSlug)
        );
        const shuffledBooks = shuffleWithSeed(
          bookCatalog,
          `books:${userDailySeed}`
        );
        const uncompletedBooks = shuffledBooks.filter(
          (book) => !completedSlugs.has(book.slug)
        );
        const completedBooks = shuffledBooks.filter((book) =>
          completedSlugs.has(book.slug)
        );

        homeBooks = [...uncompletedBooks, ...completedBooks];
        homeArticles = shuffleWithSeed(ARTICLES, `articles:${userDailySeed}`);
      }
    } catch (error) {
      console.error("[index] Gagal memuat progres user untuk rotasi beranda:", error);
    }
  }
}

Astro.response.headers.set("Cache-Control", cacheControl);
---

<BaseLayout>
  <div>
    {/* Hero Section */}
    <section class="relative overflow-hidden border-b border-line/80 bg-gradient-to-b from-accent-soft/70 via-surface to-surface pt-12 pb-16 sm:pt-20 sm:pb-24">
      <div
        aria-hidden="true"
        class="animate-hero-glow pointer-events-none absolute -top-24 left-1/2 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-emerald-400/15 blur-3xl dark:bg-emerald-500/10"
      ></div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-3xl text-center">
          <div class="animate-welcome inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent-text shadow-sm" style="animation-delay: 120ms;">
            <Sparkles className="h-3.5 w-3.5 text-accent-strong" />
            <span>Serap Pengetahuan Buku Nonfiksi Dunia Mulai dari 5 Menit</span>
          </div>

          <h1 class="animate-welcome mt-6 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl md:text-6xl" style="animation-delay: 240ms;">
            Baca Intinya,{" "}
            <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent dark:from-emerald-400 dark:to-teal-400">
              Pahami Dunianya.
            </span>
          </h1>

          <p class="animate-welcome mt-5 text-base sm:text-lg leading-relaxed text-ink-muted" style="animation-delay: 360ms;">
            Ingin memahami gagasan besar dari buku sains, sejarah, ekonomi,
            hingga psikologi tanpa tersesat di ratusan halaman?{" "}
            <strong class="font-semibold text-ink">
              Ringkasnya
            </strong>{" "}
            menyajikan sari pati buku-buku penting dunia dalam Bahasa Indonesia
            yang ringan dan mengalir, lengkap dengan{" "}
            <span class="underline decoration-emerald-400 dark:decoration-emerald-500 decoration-2 underline-offset-4">
              Mode Kilat 5–7 Menit
            </span>{" "}
            dan{" "}
            <span class="underline decoration-emerald-400 dark:decoration-emerald-500 decoration-2 underline-offset-4">
              Konsep Kunci
            </span>{" "}
            yang mudah dicerna.
          </p>

          <div class="animate-welcome mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5" style="animation-delay: 480ms;">
            <a
              href="/katalog"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-emerald-600/20 transition-all duration-200 hover:bg-emerald-700 active:scale-[0.98]"
            >
              <span>Jelajahi Katalog Buku</span>
              <ArrowRight class="h-4 w-4" />
            </a>
          </div>

          {/* Statistik Ringkas */}
          <div class="animate-welcome mt-12 grid grid-cols-3 gap-4 border-t border-line/80 pt-8 text-center" style="animation-delay: 600ms;">
            <div>
              <p class="text-2xl font-extrabold text-ink sm:text-3xl">
                5–20 <span class="text-sm font-semibold text-accent-strong">Mnt</span>
              </p>
              <p class="mt-0.5 text-xs text-ink-subtle">
                Waktu Baca Fleksibel
              </p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-ink sm:text-3xl">
                100%
              </p>
              <p class="mt-0.5 text-xs text-ink-subtle">
                Bahasa Indonesia Luwes
              </p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-ink sm:text-3xl">
                Intisari
              </p>
              <p class="mt-0.5 text-xs text-ink-subtle">
                Konsep Kunci Jernih
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Katalog Buku Interaktif */}
    <div data-reveal>
      <CatalogSection client:load books={homeBooks} />
    </div>

    {/* Seksi Metode Membaca */}
    <section
      id="metode"
      class="scroll-mt-20 border-t border-line/80 bg-surface py-16 sm:py-20"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center" data-reveal>
          <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
            Mengapa Ringkasnya?
          </span>
          <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
            Buku Berat Jadi Lebih Mudah Dipahami Siapa Saja
          </h2>
          <p class="mt-2 text-sm text-ink-muted">
            Kami menyusun argumen dan temuan penting dari buku-buku nonfiksi ke
            dalam bahasa sehari-hari yang jelas, tanpa jargon yang berbelit.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-12 sm:grid-cols-3 sm:gap-4 lg:gap-6">
          <div class="min-w-0 rounded-2xl border border-line/80 bg-page/60 p-5 sm:p-4 lg:p-6" data-reveal style="--reveal-delay: 80ms;">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-warm-tint text-warm-text lg:h-11 lg:w-11">
              <Zap className="h-5 w-5" />
            </div>
            <h3 class="mt-3.5 text-base font-bold leading-snug text-ink sm:mt-4 sm:text-sm lg:text-lg">
              1. Dua Mode Baca
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-xs lg:text-sm">
              Sedang buru-buru? Aktifkan <strong>Mode Kilat (5–7 Menit)</strong>{" "}
              untuk menangkap inti setiap bab. Ingin menyelami cerita, bukti,
              dan konteks lengkapnya? Pilih{" "}
              <strong>Mode Mendalam (15–20 Menit)</strong>.
            </p>
          </div>

          <div class="min-w-0 rounded-2xl border border-line/80 bg-page/60 p-5 sm:p-4 lg:p-6" data-reveal style="--reveal-delay: 160ms;">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-tint text-accent-text lg:h-11 lg:w-11">
              <Layers className="h-5 w-5" />
            </div>
            <h3 class="mt-3.5 text-base font-bold leading-snug text-ink sm:mt-4 sm:text-sm lg:text-lg">
              2. Konsep Kunci Mudah Diingat
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-xs lg:text-sm">
              Setiap buku dirangkum menjadi daftar konsep utama yang ditulis
              ulang dengan bahasa sederhana, sehingga gagasan besarnya cepat
              melekat dan mudah ditinjau ulang.
            </p>
          </div>

          <div class="min-w-0 rounded-2xl border border-line/80 bg-page/60 p-5 sm:p-4 lg:p-6" data-reveal style="--reveal-delay: 240ms;">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-400 lg:h-11 lg:w-11">
              <Share2 className="h-5 w-5" />
            </div>
            <h3 class="mt-3.5 text-base font-bold leading-snug text-ink sm:mt-4 sm:text-sm lg:text-lg">
              3. Kutipan Pilihan Siap Bagikan
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-xs lg:text-sm">
              Simpan gagasan paling berkesan dari setiap buku atau ubah menjadi
              kartu kutipan bergaya editorial untuk dibagikan ke teman dan
              diskusi Anda.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Artikel Pendamping */}
    <div data-reveal>
      <HomeArticlesSection articles={homeArticles} />
    </div>
    {/* Tambahkan atribut `data-reveal` (opsional `style="--reveal-delay: 120ms;"`) pada seksi baru di bawah ini agar otomatis muncul dengan animasi scroll */}
  </div>
</BaseLayout>
