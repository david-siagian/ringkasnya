---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BOOKS } from "@/data/books";
import CatalogSection from "@/components/CatalogSection";
import {
  ArrowRight,
  ListChecks,
  Share2,
  Sparkles,
  Zap,
} from "lucide-react";

const minQuickMinutes = Math.min(...BOOKS.map((b) => b.quickTimeMinutes));
---

<BaseLayout>
  <div>
    {/* Hero Section */}
    <section class="relative overflow-hidden border-b border-line/80 bg-gradient-to-b from-accent-soft/70 via-surface to-surface pt-12 pb-16 sm:pt-20 sm:pb-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-3xl text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent-text shadow-sm">
            <Sparkles className="h-3.5 w-3.5 text-accent-strong" />
            <span>Serap Ilmu Buku Best-Seller Dunia Mulai dari {minQuickMinutes} Menit</span>
          </div>

          <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl md:text-6xl">
            Baca Intinya,{" "}
            <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent dark:from-emerald-400 dark:to-teal-400">
              Praktikkan Ilmunya.
            </span>
          </h1>

          <p class="mt-5 text-base sm:text-lg leading-relaxed text-ink-muted">
            Tidak punya waktu membaca buku setebal 300 halaman?{" "}
            <strong class="font-semibold text-ink">
              Ringkasnya
            </strong>{" "}
            merangkum gagasan utama buku-buku terbaik dunia ke dalam Bahasa
            Indonesia yang mengalir, lengkap dengan{" "}
            <span class="underline decoration-emerald-400 dark:decoration-emerald-500 decoration-2 underline-offset-4">
              Mode Kilat 6–10 Menit
            </span>{" "}
            dan{" "}
            <span class="underline decoration-emerald-400 dark:decoration-emerald-500 decoration-2 underline-offset-4">
              Action Checklist
            </span>{" "}
            praktis.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3.5">
            <a
              href="/katalog"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-emerald-600/20 transition-all duration-200 hover:bg-emerald-700 active:scale-[0.98]"
            >
              <span>Jelajahi Katalog Buku</span>
              <ArrowRight class="h-4 w-4" />
            </a>
            <a
              href="/buku/atomic-habits"
              class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl border border-line bg-surface px-6 py-3.5 text-sm font-semibold text-ink-secondary shadow-sm transition-all duration-200 hover:border-line-strong hover:bg-page active:scale-[0.98]"
            >
              <Zap className="h-4 w-4 text-amber-500" />
              <span>Coba Baca: Atomic Habits</span>
            </a>
          </div>

          {/* Statistik Ringkas */}
          <div class="mt-12 grid grid-cols-3 gap-4 border-t border-line/80 pt-8 text-center">
            <div>
              <p class="text-2xl font-extrabold text-ink sm:text-3xl">
                6–30 <span class="text-sm font-semibold text-accent-strong">Mnt</span>
              </p>
              <p class="mt-0.5 text-xs text-ink-subtle">
                Waktu Baca Fleksibel
              </p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-ink sm:text-3xl">
                100%
              </p>
              <p class="mt-0.5 text-xs text-ink-subtle">
                Bahasa Indonesia Luwes
              </p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-ink sm:text-3xl">
                Aksi Nyata
              </p>
              <p class="mt-0.5 text-xs text-ink-subtle">
                Checklist Praktik Langsung
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Katalog Buku Interaktif */}
    <CatalogSection client:load books={BOOKS} />

    {/* Seksi Metode Membaca (ATM Value Proposition) */}
    <section
      id="metode"
      class="scroll-mt-20 border-t border-line/80 bg-surface py-16 sm:py-20"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
            Mengapa Ringkasnya?
          </span>
          <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
            Dirancang Agar Ilmu Buku Tidak Sekadar Lewat di Kepala
          </h2>
          <p class="mt-2 text-sm text-ink-muted">
            Kami memadukan struktur poin inti bergaya aplikasi ringkasan kelas
            dunia dengan checklist aksi yang relevan untuk keseharian Anda.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-2xl border border-line/80 bg-page/60 p-6">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-warm-tint text-warm-text">
              <Zap className="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">
              1. Mode Baca Dwi-Kecepatan
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Sedang buru-buru? Aktifkan <strong>Mode Kilat (6–10 Menit)</strong>{" "}
              untuk membaca intisari tiap bab. Ingin menyelami contoh
              dan konteks lengkap? Gunakan{" "}
              <strong>Mode Mendalam (20–30 Menit)</strong>.
            </p>
          </div>

          <div class="rounded-2xl border border-line/80 bg-page/60 p-6">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent-tint text-accent-text">
              <ListChecks className="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">
              2. Action Checklist Interaktif
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Membaca tanpa praktik tidak akan mengubah apa pun. Setiap buku
              dilengkapi daftar langkah aksi yang bisa Anda centang langsung di
              browser.
            </p>
          </div>

          <div class="rounded-2xl border border-line/80 bg-page/60 p-6">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-400">
              <Share2 className="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">
              3. Kutipan Pilihan Siap Bagikan
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Temukan kutipan paling berkesan dari setiap buku dan salin dalam
              1 klik untuk dibagikan ke teman, grup belajar, atau media sosial
              Anda.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
