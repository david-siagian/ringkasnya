---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BOOKS, CATEGORIES } from "@/data/books";
import type { BookCategory } from "@/types/book";
import {
  ArrowRight,
  Atom,
  BookOpen,
  Briefcase,
  Brain,
  Compass,
  Globe,
  Landmark,
  Sparkles,
} from "lucide-react";

const pageTitle = "Topik Pilihan — Ringkasnya";
const pageDescription =
  "Jelajahi ringkasan buku berdasarkan bidang pengetahuan: Sains & Nalar Ilmiah, Sejarah & Masyarakat, Ekonomi & Politik, Psikologi & Perilaku, Organisasi & Budaya Kerja, serta Produktivitas & Pengembangan Diri.";

const TOPIC_DETAILS: Record<
  BookCategory,
  {
    description: string;
    accentClass: string;
  }
> = {
  "Sains & Nalar Ilmiah": {
    description:
      "Pahami cara kerja alam semesta, evolusi, tidur, kesehatan, dan cara berpikir ilmiah dengan penjelasan sederhana untuk pembaca umum.",
    accentClass:
      "border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-800/60 dark:bg-cyan-950/60 dark:text-cyan-300",
  },
  "Sejarah & Masyarakat": {
    description:
      "Telusuri perjalanan peradaban manusia, geografi, dinamika sosial, dan pola besar yang membentuk dunia modern.",
    accentClass:
      "border-rose-200 bg-rose-50 text-rose-700 dark:border-rose-800/60 dark:bg-rose-950/60 dark:text-rose-300",
  },
  "Ekonomi & Politik": {
    description:
      "Pahami cara insentif, pasar, kebijakan publik, dan aturan main negara menentukan kemakmuran maupun ketimpangan.",
    accentClass:
      "border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-800/60 dark:bg-amber-950/60 dark:text-amber-300",
  },
  "Psikologi & Perilaku": {
    description:
      "Kenali cara otak mengambil keputusan, bias tersembunyi, kebiasaan manusia, dan cara kita berhubungan dengan orang lain.",
    accentClass:
      "border-sky-200 bg-sky-50 text-sky-700 dark:border-sky-800/60 dark:bg-sky-950/60 dark:text-sky-300",
  },
  "Organisasi & Budaya Kerja": {
    description:
      "Pelajari bagaimana tim dan individu bekerja fokus, mengelola prioritas, dan membangun budaya kerja yang sehat.",
    accentClass:
      "border-emerald-200 bg-emerald-50 text-emerald-700 dark:border-emerald-800/60 dark:bg-emerald-950/60 dark:text-emerald-300",
  },
  "Produktivitas & Pengembangan Diri": {
    description:
      "Bangun kebiasaan baik, fokus mendalam, pengelolaan prioritas, dan cara berkarya secara konsisten dalam keseharian.",
    accentClass:
      "border-violet-200 bg-violet-50 text-violet-700 dark:border-violet-800/60 dark:bg-violet-950/60 dark:text-violet-300",
  },
};

const topicCards = CATEGORIES.map((category) => {
  const books = BOOKS.filter((book) => book.category === category);
  return {
    category,
    books,
    ...TOPIC_DETAILS[category],
  };
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent-text">
          <Compass className="h-3.5 w-3.5 text-accent-strong" />
          <span>Eksplorasi Berdasarkan Bidang</span>
        </div>
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
          Topik Pilihan
        </h1>
        <p class="mt-3 text-base leading-relaxed text-ink-muted">
          Pilih bidang pengetahuan yang paling ingin Anda pelajari saat ini
          untuk langsung melihat daftar ringkasan bukunya.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          topicCards.map((topic) => (
            <a
              href={`/katalog?kategori=${encodeURIComponent(topic.category)}`}
              class="group flex min-w-0 flex-col justify-between rounded-2xl border border-line bg-surface p-6 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-line hover:shadow-md"
            >
              <div>
                <div class="flex items-center justify-between gap-3">
                  <span
                    class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold ${topic.accentClass}`}
                  >
                    {topic.category === "Sains & Nalar Ilmiah" && (
                      <Atom className="h-3.5 w-3.5" />
                    )}
                    {topic.category === "Sejarah & Masyarakat" && (
                      <Globe className="h-3.5 w-3.5" />
                    )}
                    {topic.category === "Ekonomi & Politik" && (
                      <Landmark className="h-3.5 w-3.5" />
                    )}
                    {topic.category === "Psikologi & Perilaku" && (
                      <Brain className="h-3.5 w-3.5" />
                    )}
                    {topic.category === "Organisasi & Budaya Kerja" && (
                      <Briefcase className="h-3.5 w-3.5" />
                    )}
                    {topic.category === "Produktivitas & Pengembangan Diri" && (
                      <Sparkles className="h-3.5 w-3.5" />
                    )}
                    <span>{topic.books.length} Buku</span>
                  </span>
                  <span class="inline-flex items-center gap-1 text-xs font-semibold text-accent-strong transition-transform group-hover:translate-x-0.5">
                    <span>Lihat Buku</span>
                    <ArrowRight className="h-3.5 w-3.5" />
                  </span>
                </div>

                <h2 class="mt-4 text-xl font-bold text-ink transition-colors group-hover:text-accent-strong">
                  {topic.category}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">
                  {topic.description}
                </p>
              </div>

              {topic.books.length > 0 ? (
                <div class="mt-6 border-t border-line-subtle pt-4">
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-faint">
                    Termasuk dalam topik ini
                  </p>
                  <ul class="mt-2 space-y-1.5">
                    {topic.books.slice(0, 3).map((book) => (
                      <li class="flex min-w-0 items-center gap-2 text-sm text-ink-secondary">
                        <BookOpen className="h-3.5 w-3.5 shrink-0 text-accent-strong" />
                        <span class="truncate">
                          <strong class="font-semibold text-ink">
                            {book.title}
                          </strong>{" "}
                          — {book.author}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <div class="mt-6 border-t border-line-subtle pt-4">
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-faint">
                    Segera hadir
                  </p>
                  <p class="mt-1.5 text-sm text-ink-muted">
                    Ringkasan buku untuk topik ini sedang disiapkan dan akan segera ditambahkan.
                  </p>
                </div>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
