---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AccountDashboard, {
  type AccountProgressBookItem,
} from "@/components/auth/AccountDashboard";
import { isGoogleOAuthConfigured } from "@/lib/auth";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/masuk?redirect=%2Fakun");
}

const serializedUser = {
  id: user.id,
  name: user.name,
  email: user.email,
  username: user.username ?? null,
  displayUsername: user.displayUsername ?? null,
  image: user.image ?? null,
  role: user.role,
  plan: user.plan,
  emailVerified: user.emailVerified,
  createdAt:
    user.createdAt instanceof Date
      ? user.createdAt.toISOString()
      : String(user.createdAt),
};

const googleEnabled = isGoogleOAuthConfigured(Astro.locals.runtime?.env);
let isGoogleLinked = false;
let progressItems: AccountProgressBookItem[] = [];
const db = Astro.locals.runtime?.env?.DB;
if (db) {
  try {
    const googleAccount = await db
      .prepare(
        "SELECT id FROM accounts WHERE user_id = ? AND provider_id = 'google' LIMIT 1"
      )
      .bind(user.id)
      .first<{ id: string }>();
    isGoogleLinked = Boolean(googleAccount);
  } catch (error) {
    console.error("[/akun] Gagal memeriksa tautan Google:", error);
  }
  try {
    const result = await db
      .prepare(
        `SELECT
          p.book_slug,
          p.is_bookmarked,
          p.last_mode,
          p.progress_percent,
          p.updated_at,
          b.title,
          b.author,
          b.category,
          b.cover_gradient,
          b.cover_image,
          b.quick_time_minutes,
          b.reading_time_minutes
        FROM user_book_progress p
        INNER JOIN books b ON b.slug = p.book_slug
        WHERE p.user_id = ? AND b.is_published = 1
        ORDER BY p.updated_at DESC`
      )
      .bind(user.id)
      .all<{
        book_slug: string;
        is_bookmarked: number;
        last_mode: string;
        progress_percent: number;
        updated_at: number;
        title: string;
        author: string;
        category: string;
        cover_gradient: string;
        cover_image: string | null;
        quick_time_minutes: number;
        reading_time_minutes: number;
      }>();

    progressItems = (result.results ?? []).map((row) => ({
      bookSlug: row.book_slug,
      isBookmarked: Boolean(row.is_bookmarked),
      lastMode: row.last_mode === "deep" ? "deep" : "quick",
      progressPercent: row.progress_percent,
      updatedAt: Number(row.updated_at),
      title: row.title,
      author: row.author,
      category: row.category,
      coverGradient: row.cover_gradient,
      coverImage: row.cover_image,
      quickTimeMinutes: row.quick_time_minutes,
      readingTimeMinutes: row.reading_time_minutes,
    }));
  } catch (error) {
    console.error("[/akun] Gagal memuat progres baca:", error);
  }
}
---

<BaseLayout
  title="Akun Saya — Ringkasnya"
  description="Kelola profil dan status akun Ringkasnya Anda."
>
  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
    <AccountDashboard
      client:load
      user={serializedUser}
      googleEnabled={googleEnabled}
      isGoogleLinked={isGoogleLinked}
      initialProgressItems={progressItems}
    />
  </main>
</BaseLayout>
