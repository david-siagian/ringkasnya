---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AccountDashboard from "@/components/auth/AccountDashboard";

export const prerender = false;

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/masuk?redirect=%2Fakun");
}

const serializedUser = {
  id: user.id,
  name: user.name,
  email: user.email,
  image: user.image ?? null,
  role: user.role,
  plan: user.plan,
  emailVerified: user.emailVerified,
  createdAt:
    user.createdAt instanceof Date
      ? user.createdAt.toISOString()
      : String(user.createdAt),
};
---

<BaseLayout
  title="Akun Saya — ringkasnya.id"
  description="Kelola profil dan status akun ringkasnya.id Anda."
>
  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 sm:py-12">
    <AccountDashboard client:load user={serializedUser} />
  </main>
</BaseLayout>
