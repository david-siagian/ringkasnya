---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getBookBySlug,
  getBookCatalog,
  PUBLIC_PAGE_CACHE_CONTROL,
} from "@/lib/books-repository";
import BookReader from "@/components/BookReader";

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const { slug } = Astro.params;
const [book, bookCatalog] = await Promise.all([
  slug ? getBookBySlug(db, slug) : Promise.resolve(null),
  getBookCatalog(db),
]);

if (!book) {
  return Astro.redirect("/404");
}

Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const relatedBooks = bookCatalog.filter((b) => b.slug !== book.slug);
const pageTitle = `Ringkasan Buku ${book.title} (${book.author}) — Ringkasnya`;
const pageDescription = `${book.tagline} Baca ringkasan ${book.title} dalam ${book.quickTimeMinutes}-${book.readingTimeMinutes} menit lengkap dengan Action Checklist.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <BookReader client:load book={book} relatedBooks={relatedBooks} />
</BaseLayout>
