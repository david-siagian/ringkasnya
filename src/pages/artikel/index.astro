---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleFeed from "@/components/ArticleFeed";
import { ARTICLES } from "@/data/articles";
import { PUBLIC_PAGE_CACHE_CONTROL } from "@/lib/books-repository";
import type { ArticleFeedItem } from "@/types/article";

export const prerender = false;

Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const articleItems: ArticleFeedItem[] = ARTICLES.map((article) => ({
  slug: article.slug,
  title: article.title,
  subtitle: article.subtitle,
  format: article.format,
  readingTimeMinutes: article.readingTimeMinutes,
  coverImage: article.coverImage,
}));

const pageTitle = "Artikel & Gagasan Ilmiah — Ringkasnya";
const pageDescription =
  "Bacaan singkat 3–4 menit seputar bedah istilah ilmiah, sintesis lintas buku, sains aktual, dan kisah eksperimen klasik di Ringkasnya.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="text-center sm:text-left">
        <h1
          class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
        >
          Artikel &amp; Gagasan Ilmiah
        </h1>
        <p class="mt-2.5 text-sm leading-relaxed text-ink-muted sm:text-base">
          Bacaan singkat 3–4 menit untuk memahami cara kerja dan contoh nyata
          berbagai konsep penting di balik buku-buku Ringkasnya.
        </p>
      </div>

      <ArticleFeed client:load items={articleItems} />
    </div>
  </div>
</BaseLayout>
