---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleFeed from "@/components/ArticleFeed";
import { getArticleFeed } from "@/lib/articles-repository";
import { PUBLIC_PAGE_CACHE_CONTROL } from "@/lib/books-repository";

export const prerender = false;

Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const articleItems = await getArticleFeed(Astro.locals.runtime?.env?.DB);

const pageTitle = "Artikel & Gagasan Ilmiah — Ringkasnya";
const pageDescription =
  "Bacaan singkat 4–6 menit seputar bedah istilah ilmiah, sintesis lintas buku, sains aktual, dan kisah eksperimen klasik di Ringkasnya.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page">
    <ArticleFeed client:load items={articleItems} />
  </div>
</BaseLayout>
