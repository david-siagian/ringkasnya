---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ARTICLES } from "@/data/articles";
import { PUBLIC_PAGE_CACHE_CONTROL } from "@/lib/books-repository";
import { ArrowRight, Clock, FileText } from "lucide-react";

export const prerender = false;

Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const pageTitle = "Artikel & Bedah Istilah Ilmiah — Ringkasnya";
const pageDescription =
  "Bacaan singkat 5–7 menit yang membedah istilah ilmiah, prinsip terkenal, dan bias kognitif di balik buku-buku nonfiksi terbaik di Ringkasnya.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="text-center sm:text-left">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent-text"
        >
          <FileText className="h-3.5 w-3.5 text-accent-strong" />
          <span>Artikel ({ARTICLES.length})</span>
        </div>
        <h1
          class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
        >
          Bedah Istilah &amp; Gagasan Ilmiah
        </h1>
        <p class="mt-2.5 text-sm leading-relaxed text-ink-muted sm:text-base">
          Bacaan singkat 5–7 menit untuk memahami asal-usul, cara kerja, dan
          contoh nyata berbagai konsep penting di balik buku-buku Ringkasnya.
        </p>
      </div>

      <section
        aria-label="Daftar Artikel"
        class="mt-8 overflow-hidden rounded-2xl border border-line bg-surface shadow-sm divide-y divide-line-subtle"
      >
        {
          ARTICLES.map((article) => (
            <a
              href={`/artikel/${article.slug}`}
              class="group flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-page/70 focus:outline-none focus-visible:bg-accent-soft/60 sm:px-6 sm:py-5"
            >
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <h2 class="text-base font-extrabold leading-snug text-ink transition-colors group-hover:text-accent-strong sm:text-lg">
                    {article.title}
                  </h2>
                  <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-surface-subtle px-2.5 py-0.5 text-[11px] font-semibold text-ink-muted">
                    <Clock className="h-3 w-3 text-accent-strong" />
                    <span>{article.readingTimeMinutes} mnt baca</span>
                  </span>
                </div>
                <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-secondary">
                  {article.subtitle}
                </p>
              </div>

              <ArrowRight className="h-4 w-4 shrink-0 text-ink-faint transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent-strong" />
            </a>
          ))
        }
      </section>
    </div>
  </div>
</BaseLayout>
