---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ARTICLES } from "@/data/articles";
import { PUBLIC_PAGE_CACHE_CONTROL } from "@/lib/books-repository";
import { ArrowRight, Clock, FileText } from "lucide-react";

export const prerender = false;

Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const pageTitle = "Artikel & Bedah Istilah Ilmiah — Ringkasnya";
const pageDescription =
  "Bacaan singkat 3–4 menit yang membedah istilah ilmiah, prinsip terkenal, dan bias kognitif di balik buku-buku nonfiksi terbaik di Ringkasnya.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="text-center sm:text-left">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent-text"
        >
          <FileText className="h-3.5 w-3.5 text-accent-strong" />
          <span>Artikel ({ARTICLES.length})</span>
        </div>
        <h1
          class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
        >
          Bedah Istilah &amp; Gagasan Ilmiah
        </h1>
        <p class="mt-2.5 text-sm leading-relaxed text-ink-muted sm:text-base">
          Bacaan singkat 3–4 menit untuk memahami cara kerja dan contoh nyata
          berbagai konsep penting di balik buku-buku Ringkasnya.
        </p>
      </div>

      <section aria-label="Daftar Artikel" class="mt-8 space-y-4 sm:space-y-5">
        {
          ARTICLES.map((article) => (
            <a
              href={`/artikel/${article.slug}`}
              class="group flex items-center gap-4 rounded-2xl border border-line bg-surface p-4 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-accent-strong hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/40 sm:gap-5 sm:p-5"
            >
              {article.coverImage && (
                <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-xl shadow-sm ring-1 ring-line/60 sm:h-24 sm:w-24">
                  <img
                    src={article.coverImage}
                    alt={`Ilustrasi ${article.title}`}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
              )}

              <div class="min-w-0 flex-1">
                <h2 class="text-base font-extrabold leading-snug text-ink transition-colors group-hover:text-accent-strong sm:text-lg">
                  {article.title}
                </h2>
                <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-ink-secondary">
                  {article.subtitle}
                </p>
                <div class="mt-2.5 inline-flex items-center gap-1.5 text-xs font-medium text-ink-subtle">
                  <Clock className="h-3.5 w-3.5" />
                  <span>{article.readingTimeMinutes} menit baca</span>
                </div>
              </div>

              <ArrowRight className="hidden h-4 w-4 shrink-0 text-ink-faint transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent-strong sm:block" />
            </a>
          ))
        }
      </section>
    </div>
  </div>
</BaseLayout>
