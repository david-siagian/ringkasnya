---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleListSection, {
  type ArticleListItem,
} from "@/components/ArticleListSection";
import { ARTICLES } from "@/data/articles";
import {
  getBookCatalog,
  PUBLIC_PAGE_CACHE_CONTROL,
} from "@/lib/books-repository";
import { FileText } from "lucide-react";

export const prerender = false;

const bookCatalog = await getBookCatalog(Astro.locals.runtime?.env?.DB);
Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const bookTitleMap = new Map(bookCatalog.map((book) => [book.slug, book.title]));

const articleItems: ArticleListItem[] = ARTICLES.map((article) => ({
  slug: article.slug,
  title: article.title,
  subtitle: article.subtitle,
  term: article.term,
  category: article.category,
  readingTimeMinutes: article.readingTimeMinutes,
  originLabel: article.originLabel,
  coverGradient: article.coverGradient,
  accentBadge: article.accentBadge,
  relatedBookTitles: article.relatedBookSlugs
    .map((slug) => bookTitleMap.get(slug))
    .filter((title): title is string => Boolean(title)),
}));

const pageTitle = "Artikel & Bedah Istilah Ilmiah — Ringkasnya";
const pageDescription =
  "Bacaan singkat 5–7 menit yang membedah istilah ilmiah, prinsip terkenal, dan bias kognitif di balik buku-buku nonfiksi terbaik di Ringkasnya.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent-text"
        >
          <FileText className="h-3.5 w-3.5 text-accent-strong" />
          <span>Artikel &amp; Bedah Istilah ({ARTICLES.length})</span>
        </div>
        <h1
          class="mt-4 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl"
        >
          Pahami Istilah Penting di Balik Buku Favoritmu
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">
          Artikel singkat 5–7 menit yang mengulas asal-usul, cara kerja, dan
          contoh nyata berbagai prinsip ilmiah yang sering muncul di ringkasan
          buku Ringkasnya.
        </p>
      </div>

      <div class="mt-10">
        <ArticleListSection client:load articles={articleItems} />
      </div>
    </div>
  </div>
</BaseLayout>
