---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ARTICLES, getArticleBySlug } from "@/data/articles";
import { formatArticlePublishedDate } from "@/types/article";
import {
  getBookCatalog,
  PUBLIC_PAGE_CACHE_CONTROL,
} from "@/lib/books-repository";
import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Calendar,
  CheckCircle2,
  Clock,
  Lightbulb,
  Sparkles,
  Zap,
} from "lucide-react";

export const prerender = false;

const { slug } = Astro.params;
const article = slug ? getArticleBySlug(slug) : undefined;

if (!article) {
  return Astro.redirect("/404");
}

const bookCatalog = await getBookCatalog(Astro.locals.runtime?.env?.DB);
Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const fromBookSlug = Astro.url.searchParams.get("from");
const originBook = fromBookSlug
  ? bookCatalog.find((book) => book.slug === fromBookSlug)
  : undefined;

const relatedBooks = article.relatedBookSlugs
  .map((bookSlug) => bookCatalog.find((book) => book.slug === bookSlug))
  .filter((book): book is (typeof bookCatalog)[number] => Boolean(book));

const otherArticles = ARTICLES.filter((other) => other.slug !== article.slug).slice(
  0,
  3
);

const pageTitle = `${article.title} — Artikel Ringkasnya`;
const pageDescription = `${article.shortDefinition} Baca penjelasan lengkapnya dalam ${article.readingTimeMinutes} menit di Ringkasnya.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page pb-20">
    <!-- Header Artikel Polos (Editorial) -->
    <header class={`border-b border-white/10 bg-slate-900 bg-gradient-to-br ${article.coverGradient} text-white`}>
      <div class="mx-auto max-w-3xl px-4 py-7 sm:px-6 sm:py-9">
        <div class="flex flex-wrap items-center justify-between gap-3">
          {
            originBook ? (
              <a
                href={`/buku/${originBook.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/85 transition hover:text-white"
              >
                <ArrowLeft className="h-3.5 w-3.5" />
                <span>Kembali ke {originBook.title}</span>
              </a>
            ) : (
              <a
                href="/artikel"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/85 transition hover:text-white"
              >
                <ArrowLeft className="h-3.5 w-3.5" />
                <span>Semua Artikel</span>
              </a>
            )
          }

          {
            originBook && (
              <a
                href="/artikel"
                class="inline-flex items-center gap-1 text-xs font-medium text-white/70 transition hover:text-white"
              >
                <span>Lihat Semua Artikel</span>
              </a>
            )
          }
        </div>

        <div class="mt-5">
          <div class="flex flex-wrap items-center gap-2.5 text-xs text-white/75">
            <span class="font-semibold text-white">
              {article.accentBadge}
            </span>
            <span aria-hidden="true" class="text-white/40">•</span>
            <span class="inline-flex items-center gap-1">
              <Calendar className="h-3.5 w-3.5 text-white/60" />
              <span>{formatArticlePublishedDate(article.publishedAt)}</span>
            </span>
            <span aria-hidden="true" class="text-white/40">•</span>
            <span class="inline-flex items-center gap-1">
              <Clock className="h-3.5 w-3.5 text-white/60" />
              <span>{article.readingTimeMinutes} menit baca</span>
            </span>
          </div>

          <h1
            class="mt-2.5 text-2xl font-extrabold tracking-tight text-white sm:text-3xl"
          >
            {article.title}
          </h1>
          <p class="mt-2 text-sm leading-relaxed text-white/80 sm:text-base">
            {article.subtitle}
          </p>
        </div>
      </div>
    </header>

    <!-- Isi Artikel -->
    <main class="mx-auto max-w-5xl px-4 pt-7 sm:px-6 sm:pt-8">
      <div class="mx-auto max-w-3xl">
        <article class="rounded-xl border border-line/85 bg-surface p-5 sm:p-8">
          <!-- Paragraf Pembuka -->
          <p
            class="border-l-4 border-emerald-500 pl-4 text-base font-medium leading-relaxed text-ink sm:text-lg"
          >
            {article.leadParagraph}
          </p>

          <!-- Bagian-bagian Utama -->
          <div class="mt-8 space-y-8">
            {
              article.sections.map((section, index) => (
                <section id={`bagian-${index + 1}`} class="scroll-mt-24">
                  <h2 class="text-xl font-extrabold tracking-tight text-ink sm:text-2xl">
                    {section.heading}
                  </h2>
                  <div class="mt-3.5 space-y-4 text-sm leading-relaxed text-ink-secondary sm:text-base">
                    {section.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>

                  {section.highlightBox && (
                    <div class="mt-5 flex items-start gap-3 rounded-xl border border-warm-line bg-warm-soft p-4 sm:p-5">
                      <Lightbulb className="mt-0.5 h-5 w-5 shrink-0 text-warm-text" />
                      <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-warm-heading">
                          {section.highlightBox.label}
                        </span>
                        <p class="mt-1 text-sm leading-relaxed text-ink-secondary">
                          {section.highlightBox.text}
                        </p>
                      </div>
                    </div>
                  )}
                </section>
              ))
            }
          </div>

          <!-- Intisari Cepat -->
          <section
            class="mt-10 rounded-2xl border border-accent-line bg-accent-soft/75 p-5 sm:p-6"
          >
            <div class="inline-flex items-center gap-2 text-accent-text">
              <Sparkles className="h-4 w-4 text-accent-strong" />
              <span class="text-xs font-bold uppercase tracking-wider">
                Intisari Cepat
              </span>
            </div>
            <ul class="mt-3 space-y-2.5">
              {
                article.keyTakeaways.map((point) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink">
                    <CheckCircle2 className="mt-0.5 h-4 w-4 shrink-0 text-accent-strong" />
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </article>

        <!-- Tautan Ringkas ke Buku Terkait -->
        {
          relatedBooks.length > 0 && (
            <div class="mt-6 rounded-xl border border-line/70 bg-surface/70 p-4 sm:p-5">
              <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink-secondary">
                <BookOpen className="h-4 w-4 text-accent-strong" />
                <span>Dibahas di buku</span>
              </span>
              <div class="mt-3.5 grid grid-cols-1 gap-3.5 sm:grid-cols-2">
                {relatedBooks.map((book) => (
                  <a
                    href={`/buku/${book.slug}`}
                    class="group flex min-w-0 items-center gap-3 rounded-lg border border-line/70 bg-page/50 p-2.5 transition-colors hover:border-accent-line hover:bg-surface"
                  >
                    <div class="relative aspect-[3/4] w-12 shrink-0 sm:w-14 overflow-hidden rounded-md ring-1 ring-line/70">
                      {book.coverImage ? (
                        <img
                          src={book.coverImage}
                          alt={`Sampul buku ${book.title}`}
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <div
                          class={`flex h-full w-full items-center justify-center bg-slate-900 bg-gradient-to-br ${book.coverGradient} text-white`}
                        >
                          <BookOpen className="h-4 w-4 opacity-85" />
                        </div>
                      )}
                    </div>
                    <div class="min-w-0 flex-1">
                      <h3 class="line-clamp-2 text-sm font-bold leading-snug text-ink group-hover:text-accent-strong">
                        {book.title}
                      </h3>
                      <p class="mt-0.5 line-clamp-1 text-xs text-ink-subtle">
                        {book.author} · {book.year}
                      </p>
                      <p class="mt-1 flex flex-wrap items-center gap-x-2.5 text-[11px] text-ink-subtle">
                        <span class="inline-flex items-center gap-1">
                          <Zap className="h-3 w-3 text-ink-faint" />
                          Kilat {book.quickTimeMinutes} mnt
                        </span>
                        <span class="inline-flex items-center gap-1">
                          <Clock className="h-3 w-3 text-ink-faint" />
                          Mendalam {book.readingTimeMinutes} mnt
                        </span>
                      </p>
                    </div>
                    <ArrowRight className="h-3.5 w-3.5 shrink-0 text-ink-faint transition-transform group-hover:translate-x-0.5" />
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <!-- Artikel Lainnya -->
      {
        otherArticles.length > 0 && (
          <section class="mt-10 border-t border-line/70 pt-7">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-base font-bold text-ink sm:text-lg">
                Artikel Lainnya
              </h2>
              <a
                href="/artikel"
                class="inline-flex items-center gap-1 text-xs font-semibold text-accent-text transition hover:text-accent-strong"
              >
                <span>Semua Artikel</span>
                <ArrowRight className="h-3.5 w-3.5" />
              </a>
            </div>

            <div class="mt-3.5 grid grid-cols-1 gap-3.5 md:grid-cols-2 sm:gap-4">
              {otherArticles.map((other) => (
                <a
                  href={`/artikel/${other.slug}`}
                  class="group flex items-start gap-3.5 rounded-xl border border-line/85 bg-surface p-3.5 transition-colors duration-150 hover:border-accent-line hover:bg-surface-subtle/40 sm:gap-4 sm:p-4"
                >
                  {other.coverImage && (
                    <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-slate-950 ring-1 ring-line/60 sm:h-20 sm:w-20">
                      <img
                        src={other.coverImage}
                        alt={`Ilustrasi ${other.title}`}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}

                  <div class="flex min-w-0 flex-1 flex-col justify-between">
                    <div>
                      <div class="flex items-center gap-2 text-[11px]">
                        <span class="truncate font-semibold text-accent-text">
                          {other.accentBadge}
                        </span>
                        <span aria-hidden="true" class="text-ink-faint">•</span>
                        <span class="inline-flex shrink-0 items-center gap-1 text-ink-subtle">
                          <Calendar className="h-3 w-3 text-ink-faint" />
                          {formatArticlePublishedDate(other.publishedAt)}
                        </span>
                      </div>
                      <h3 class="mt-1 line-clamp-2 text-sm font-bold leading-snug text-ink transition-colors group-hover:text-accent-strong sm:text-base">
                        {other.title}
                      </h3>
                      <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-ink-muted">
                        {other.subtitle}
                      </p>
                    </div>
                  </div>

                  <ArrowUpRight className="mt-1 h-4 w-4 shrink-0 text-ink-faint transition-transform duration-150 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent-strong" />
                </a>
              ))}
            </div>
          </section>
        )
      }
    </main>
  </div>
</BaseLayout>
