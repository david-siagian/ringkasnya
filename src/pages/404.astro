---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowLeft, BookOpen } from "lucide-react";
---

<BaseLayout title="Buku Tidak Ditemukan — ringkasnya.id">
  <div class="mx-auto flex max-w-xl flex-col items-center justify-center px-4 py-24 text-center">
    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent-tint text-accent-text">
      <BookOpen className="h-7 w-7" />
    </div>
    <h1 class="mt-6 text-2xl font-extrabold text-ink sm:text-3xl">
      Halaman atau Buku Tidak Ditemukan
    </h1>
    <p class="mt-2 text-sm text-ink-muted">
      Maaf, ringkasan buku yang Anda cari belum tersedia atau alamat URL telah
      berubah.
    </p>
    <a
      href="/"
      class="mt-6 inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-700"
    >
      <ArrowLeft className="h-4 w-4" />
      <span>Kembali ke Beranda</span>
    </a>
  </div>
</BaseLayout>
