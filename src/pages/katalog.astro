---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getBookCatalog,
  PUBLIC_PAGE_CACHE_CONTROL,
} from "@/lib/books-repository";
import CatalogSection from "@/components/CatalogSection";

export const prerender = false;

const bookCatalog = await getBookCatalog(Astro.locals.runtime?.env?.DB);
Astro.response.headers.set("Cache-Control", PUBLIC_PAGE_CACHE_CONTROL);

const pageTitle = "Katalog Buku Lengkap — Ringkasnya";
const pageDescription =
  "Jelajahi seluruh koleksi ringkasan buku nonfiksi sains, sejarah, ekonomi, politik, dan psikologi dalam Bahasa Indonesia lengkap dengan Mode Kilat dan Konsep Kunci.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page">
    <CatalogSection
      client:load
      books={bookCatalog}
      mode="full"
      itemsPerPage={20}
    />
  </div>
</BaseLayout>
