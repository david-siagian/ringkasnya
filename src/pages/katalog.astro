---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BOOK_CATALOG } from "@/data/books";
import CatalogSection from "@/components/CatalogSection";

const pageTitle = "Katalog Buku Lengkap — Ringkasnya";
const pageDescription =
  "Jelajahi seluruh koleksi ringkasan buku best-seller dunia dalam Bahasa Indonesia lengkap dengan Mode Kilat dan Action Checklist.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page">
    <CatalogSection
      client:load
      books={BOOK_CATALOG}
      mode="full"
      itemsPerPage={20}
    />
  </div>
</BaseLayout>
