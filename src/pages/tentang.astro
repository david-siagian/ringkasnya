---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BOOKS, CATEGORIES } from "@/data/books";
import {
  ArrowRight,
  BookOpen,
  Clock,
  Info,
  Layers,
  Share2,
  Sparkles,
  Zap,
} from "lucide-react";

const pageTitle = "Tentang Ringkasnya — Baca Intinya, Pahami Dunianya";
const pageDescription =
  "Kenali misi Ringkasnya dalam merangkum buku nonfiksi sains, sejarah, ekonomi, politik, dan psikologi ke Bahasa Indonesia yang mudah dipahami lengkap dengan Mode Kilat, Mode Mendalam, dan Konsep Kunci.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-page">
    <section class="border-b border-line/80 bg-surface py-14 sm:py-20">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent-line bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent-text">
          <Info className="h-3.5 w-3.5 text-accent-strong" />
          <span>Tentang Platform</span>
        </div>
        <h1 class="mt-5 text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
          Membantu Pembaca Indonesia{" "}
          <span class="bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent dark:from-emerald-400 dark:to-teal-400">
            Menyerap Pengetahuan Penting
          </span>{" "}
          dari Buku Terbaik Dunia.
        </h1>
        <p class="mt-5 text-base leading-relaxed text-ink-muted sm:text-lg">
          Banyak buku bagus di bidang sains, sejarah, ekonomi, politik, dan
          psikologi terasa berat karena tebal atau bahasanya terlalu teknis.{" "}
          <strong class="font-semibold text-ink">Ringkasnya</strong> hadir
          untuk menyederhanakan gagasan utamanya ke dalam Bahasa Indonesia yang
          mengalir, jernih, dan mudah diikuti pembaca umum.
        </p>

        <div class="mt-10 grid grid-cols-3 gap-4 border-t border-line/80 pt-8 text-center">
          <div>
            <p class="text-2xl font-extrabold text-ink sm:text-3xl">
              {BOOKS.length}
            </p>
            <p class="mt-0.5 text-xs text-ink-subtle">Buku Terkurasi</p>
          </div>
          <div>
            <p class="text-2xl font-extrabold text-ink sm:text-3xl">
              {CATEGORIES.length}
            </p>
            <p class="mt-0.5 text-xs text-ink-subtle">Topik Utama</p>
          </div>
          <div>
            <p class="text-2xl font-extrabold text-ink sm:text-3xl">
              5–20 <span class="text-sm font-semibold text-accent-strong">Mnt</span>
            </p>
            <p class="mt-0.5 text-xs text-ink-subtle">Durasi Fleksibel</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-bold uppercase tracking-wider text-accent-strong">
            Cara Kerja Ringkasnya
          </span>
          <h2 class="mt-1 text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
            Tiga Pilar Pengalaman Membaca
          </h2>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          <div class="rounded-2xl border border-line bg-surface p-6 shadow-xs">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent-strong">
              <Zap className="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">
              Mode Kilat &amp; Mode Mendalam
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Pilih <strong>Mode Kilat (5–7 menit)</strong> saat ingin
              menangkap inti buku dengan cepat, atau beralih ke{" "}
              <strong>Mode Mendalam (15–20 menit)</strong> untuk memahami
              cerita, data, dan konteks lengkapnya.
            </p>
          </div>

          <div class="rounded-2xl border border-line bg-surface p-6 shadow-xs">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent-strong">
              <Layers className="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">
              Konsep Kunci Sederhana
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Setiap ringkasan ditutup dengan daftar Konsep Kunci dalam bahasa
              sehari-hari yang jernih, agar gagasan utama buku cepat dipahami
              dan mudah diingat.
            </p>
          </div>

          <div class="rounded-2xl border border-line bg-surface p-6 shadow-xs">
            <div class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-accent-soft text-accent-strong">
              <Share2 className="h-5 w-5" />
            </div>
            <h3 class="mt-4 text-lg font-bold text-ink">
              Kutipan &amp; Bahasa Mengalir
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              Ditulis ulang dengan bahasa yang natural untuk pembaca Indonesia,
              lengkap dengan kartu kutipan yang siap disimpan atau dibagikan
              sebagai pengingat gagasan penting.
            </p>
          </div>
        </div>

        <div class="mt-12 rounded-2xl border border-accent-line bg-accent-soft/60 p-6 text-center sm:p-8">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-accent-text">
            <Sparkles className="h-4 w-4 text-accent-strong" />
            <span>Siap Mulai Membaca?</span>
          </div>
          <h3 class="mt-2 text-xl font-extrabold text-ink sm:text-2xl">
            Temukan Ringkasan Buku Pertama Anda Hari Ini
          </h3>
          <p class="mx-auto mt-2 max-w-xl text-sm text-ink-muted">
            Jelajahi seluruh koleksi buku atau pilih bidang pengetahuan yang
            paling ingin Anda pahami saat ini.
          </p>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a
              href="/katalog"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition-colors hover:bg-emerald-700 sm:w-auto"
            >
              <BookOpen className="h-4 w-4" />
              <span>Buka Katalog Buku</span>
              <ArrowRight className="h-4 w-4" />
            </a>
            <a
              href="/topik"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-line bg-surface px-6 py-3 text-sm font-semibold text-ink-secondary transition-colors hover:bg-page sm:w-auto"
            >
              <Clock className="h-4 w-4 text-accent-strong" />
              <span>Lihat Topik Pilihan</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
