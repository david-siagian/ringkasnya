---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthAmbientBackground from "@/components/auth/AuthAmbientBackground.astro";
import AuthCardShell from "@/components/auth/AuthCardShell.astro";
import RegisterForm from "@/components/auth/RegisterForm";
import { isGoogleOAuthConfigured } from "@/lib/auth";
import { getSafeRedirect } from "@/lib/auth-modal";

export const prerender = false;

const rawRedirect = Astro.url.searchParams.get("redirect") ?? undefined;
const safeRedirect = getSafeRedirect(rawRedirect);

if (Astro.locals.user) {
  return Astro.redirect(safeRedirect);
}

const googleEnabled = isGoogleOAuthConfigured(Astro.locals.runtime?.env);
---

<BaseLayout
  title="Daftar Akun — Ringkasnya"
  description="Buat akun gratis di Ringkasnya untuk membaca ringkasan buku best-seller dan menyimpan progres bacaan Anda."
  lockBodyScroll
>
  <AuthAmbientBackground />

  <AuthCardShell
    slot="overlay"
    title="Buat Akun Gratis"
    headingId="register-card-title"
  >
    <Fragment slot="subtitle">
      Mulai kebiasaan membaca 10 menit sehari bersama <span class="font-semibold text-accent-text">Ringkasnya</span>.
    </Fragment>

    <RegisterForm
      client:load
      googleEnabled={googleEnabled}
      redirectTo={rawRedirect}
    />
  </AuthCardShell>
</BaseLayout>
