---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandLogo from "@/components/BrandLogo";
import RegisterForm from "@/components/auth/RegisterForm";
import { isGoogleOAuthConfigured } from "@/lib/auth";

export const prerender = false;

const rawRedirect = Astro.url.searchParams.get("redirect") ?? undefined;
const safeRedirect =
  rawRedirect && rawRedirect.startsWith("/") && !rawRedirect.startsWith("//")
    ? rawRedirect
    : "/akun";

if (Astro.locals.user) {
  return Astro.redirect(safeRedirect);
}

const googleEnabled = isGoogleOAuthConfigured(Astro.locals.runtime?.env);
---

<BaseLayout
  title="Daftar Akun — ringkasnya.id"
  description="Buat akun gratis di ringkasnya.id untuk membaca ringkasan buku best-seller dan menyimpan progres bacaan Anda."
>
  <main class="mx-auto flex min-h-[calc(100vh-14rem)] max-w-md flex-col justify-center px-4 py-12 sm:px-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
      <div class="mb-6 text-center">
        <a href="/" class="inline-flex flex-col items-center gap-2">
          <BrandLogo className="h-12 w-12" />
        </a>
        <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900">
          Buat Akun Gratis
        </h1>
        <p class="mt-1.5 text-sm text-slate-600">
          Mulai kebiasaan membaca 10 menit sehari bersama <span class="font-semibold text-emerald-700">ringkasnya.id</span>.
        </p>
      </div>

      <RegisterForm
        client:load
        googleEnabled={googleEnabled}
        redirectTo={rawRedirect}
      />
    </div>
  </main>
</BaseLayout>
